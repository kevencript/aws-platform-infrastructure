# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Variable files are ignored by default, because ad-hoc ones tend to collect
# secrets. The per-environment files are the exception: they are committed,
# hold no secret and are reviewed like any other change.
*.tfvars
*.tfvars.json
!environments/*/terraform.tfvars
!environments/*/bootstrap.tfvars

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Saved plans, written by: terraform plan -out=tfplan
*tfplan*

# Throwaway configuration written by tools/check-environments.sh
.environment-check/

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout

# Operating system and editor files
.DS_Store
.idea/
.vscode/
*.swp

# Logs and local environment files
*.log
.env
.env.*